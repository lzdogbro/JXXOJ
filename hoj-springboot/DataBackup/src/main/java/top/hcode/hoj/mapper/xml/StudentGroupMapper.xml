<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.hcode.hoj.mapper.StudentGroupMapper">

    <resultMap id="map_GroupList" type="top.hcode.hoj.pojo.vo.StudentGroupVO">
        <id column="id" property="id"></id>
        <result column="name" property="name"></result>
        <result column="owner_uid" property="ownerUid"></result>
        <result column="description" property="description"></result>
        <result column="member_count" property="memberCount"></result>
        <result column="gmt_create" property="gmtCreate"></result>
        <result column="gmt_modified" property="gmtModified"></result>
    </resultMap>

    <select id="getGroupList" resultMap="map_GroupList">
        SELECT g.id, g.name, g.owner_uid, g.description, g.gmt_create, g.gmt_modified,
               COALESCE(gu.member_count, 0) AS member_count
        FROM student_group g
        LEFT JOIN (
            SELECT gid, COUNT(*) AS member_count FROM student_group_user GROUP BY gid
        ) gu ON gu.gid = g.id
        <where>
            g.is_deleted = 0
            <if test="ownerUid != null and ownerUid != ''">
                AND g.owner_uid = #{ownerUid}
            </if>
        </where>
        ORDER BY g.id DESC
    </select>
</mapper>
