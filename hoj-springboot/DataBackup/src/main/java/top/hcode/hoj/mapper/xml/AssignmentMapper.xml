<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.hcode.hoj.mapper.AssignmentMapper">

    <resultMap id="map_AssignmentList" type="top.hcode.hoj.pojo.vo.AssignmentVO">
        <id column="id" property="id"></id>
        <result column="title" property="title"></result>
        <result column="description" property="description"></result>
        <result column="creator_uid" property="creatorUid"></result>
        <result column="creator_username" property="creatorUsername"></result>
        <result column="is_required" property="isRequired"></result>
        <result column="status" property="status"></result>
        <result column="start_time" property="startTime"></result>
        <result column="end_time" property="endTime"></result>
        <result column="is_deleted" property="isDeleted"></result>
        <result column="problem_count" property="problemCount"></result>
        <result column="gmt_create" property="gmtCreate"></result>
        <result column="gmt_modified" property="gmtModified"></result>
    </resultMap>

    <select id="getAssignmentList" resultMap="map_AssignmentList">
        SELECT a.id, a.title, a.description, a.creator_uid, a.is_required, a.status,
               a.start_time, a.end_time, a.is_deleted, a.gmt_create, a.gmt_modified,
               u.username AS creator_username,
               COALESCE(pc.problem_count, 0) AS problem_count
        FROM assignment a
        LEFT JOIN user_info u ON a.creator_uid = u.uuid
        LEFT JOIN (
            SELECT aid, COUNT(*) AS problem_count FROM assignment_problem GROUP BY aid
        ) pc ON pc.aid = a.id
        <where>
            a.is_deleted = 0
            <if test="creatorUid != null and creatorUid != ''">
                AND a.creator_uid = #{creatorUid}
            </if>
            <if test="status != null">
                AND a.status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (a.title LIKE CONCAT('%', #{keyword}, '%') OR a.id LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY a.id DESC
    </select>
</mapper>
